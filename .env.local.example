# Plantilla versionada. Copia a .env.local (ignorado por git) y completa los valores.
# direnv lo carga solo al entrar en la carpeta. No subas el .env.local.

# Postgres de Backstage (puerto propio del reto, no el 5432)
POSTGRES_USER=backstage
POSTGRES_PASSWORD=
POSTGRES_PORT=5442

# Puertos de Backstage del reto (no 3000/7007)
BACKSTAGE_WEB_PORT=3100
BACKSTAGE_BACKEND_PORT=7100

# Token del scaffolder: fine-grained PAT limitado a la org jh-platform-lab, con permisos
# Contents, Administration, Workflows y Metadata (lectura/escritura). No uses el token de gh.
GITHUB_TOKEN=

# Imagen de Backstage en contenedor. Por defecto se baja la ultima del CI (GHCR).
# Para probar una rama construida en tu maquina (bash scripts/build-backstage-image.sh):
# BACKSTAGE_IMAGE=wenia/backstage:local
# BACKSTAGE_PULL=never

# Login con GitHub (OAuth App). Callback: http://localhost:3100/api/auth/github/handler/frame
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# New Relic: el backend envia un evento WeniaServiceRegistered al registrar un servicio.
# License key de ingesta y ID de cuenta (numero). NEW_RELIC_REGION=eu si tu cuenta es de la UE.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_REGION=us
